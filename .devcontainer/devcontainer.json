// https://containers.dev/
{
  "name": "Ansible DevContainer",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "ARG_USER": "${localEnv:USER}"
    }
  },
  // Molecule drives its test containers over the Docker socket, so
  // the Dev Container needs access to one. Without this, `invoke
  // test-molecule` has nothing to talk to; `invoke test-static` does
  // not need it. See doc/TESTING.adoc.
  //
  // The Dockerfile installs only the Docker CLI (Ubuntu 26.04's own
  // docker.io package); the host's own daemon is used via the
  // bind-mounted socket below, rather than running a nested dockerd
  // (the devcontainers docker-in-docker feature's approach) or
  // relying on a third-party apt repo.
  "remoteUser": "${localEnv:USER}",
  // Fixes up group membership for the socket mount below - the
  // host's docker group GID varies by machine, so it can't be baked
  // into the image and has to be handled at container start instead.
  "postStartCommand": "/usr/local/share/fix-docker-gid.sh",
  "customizations": {
    "vscode": {
      // VS code extensions
      "extensions": [
        "EditorConfig.EditorConfig",
        "redhat.ansible",
        "dhoeric.ansible-vault",
        "asciidoctor.asciidoctor-vscode",
        "wholroyd.jinja",
        "charliermarsh.ruff",
        "dchanco.vsc-invoke",
        "ms-python.python",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-containers",
        "ms-vscode-remote.remote-containers",
        "Anthropic.claude-code",
        "Redis.redis-for-vscode"
      ],
      "settings": {
        // Use bash as default shell
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/usr/bin/bash"
          }
        }
      }
    }
  },
  "runArgs": [
    "--hostname=dev_host"
  ],
  "mounts": [
    // Make user settings available in container
    "source=${localEnv:HOME}/.bashrc,target=${localEnv:HOME}/.bashrc,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=${localEnv:HOME}/.gitconfig,type=bind",
    "source=${localEnv:HOME}/.config,target=${localEnv:HOME}/.config,type=bind",
    // Mount ssh keys
    "source=${localEnv:HOME}/.ssh,target=${localEnv:HOME}/.ssh,type=bind",
    // Claude
    "source=${localEnv:HOME}/.claude,target=${localEnv:HOME}/.claude,type=bind",
    // Mount the host's docker socket, so molecule's docker driver
    // can talk to the host's daemon directly.
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    // Mount current workspace
    "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached"
  ]
}

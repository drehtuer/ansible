// https://containers.dev/
{
  "name": "Ansible DevContainer",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "ARG_USER": "${localEnv:USER}"
    }
  },
  // Molecule drives its test containers over the Docker socket, so
  // the Dev Container needs a Docker daemon of its own. Without this,
  // `invoke test-molecule` has nothing to talk to; `invoke
  // test-static` does not need it. See doc/TESTING.adoc.
  //
  // Docker itself is installed by the Dockerfile (Ubuntu 26.04's own
  // docker.io package) and started by docker-init.sh, rather than
  // via the devcontainers docker-in-docker feature: that feature's
  // install script hardcodes which Ubuntu codenames it supports, and
  // has not caught up with 26.04 ('resolute') yet.
  "remoteUser": "${localEnv:USER}",
  "customizations": {
    "vscode": {
      // VS code extensions
      "extensions": [
        "EditorConfig.EditorConfig",
        "redhat.ansible",
        "dhoeric.ansible-vault",
        "asciidoctor.asciidoctor-vscode",
        "wholroyd.jinja",
        "charliermarsh.ruff",
        "dchanco.vsc-invoke",
        "ms-python.python",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-containers",
        "ms-vscode-remote.remote-containers",
        "Anthropic.claude-code"
      ],
      "settings": {
        // Use bash as default shell
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/usr/bin/bash"
          }
        }
      }
    }
  },
  "runArgs": [
    "--hostname=dev_host",
    // dockerd (started by docker-init.sh) needs to create its
    // own network namespaces, mounts and cgroups; without this
    // it fails to start.
    "--privileged"
  ],
  "mounts": [
    // Make user settings available in container
    "source=${localEnv:HOME}/.bashrc,target=${localEnv:HOME}/.bashrc,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=${localEnv:HOME}/.gitconfig,type=bind",
    "source=${localEnv:HOME}/.config,target=${localEnv:HOME}/.config,type=bind",
    // Mount ssh keys
    "source=${localEnv:HOME}/.ssh,target=${localEnv:HOME}/.ssh,type=bind",
    // Claude
    "source=${localEnv:HOME}/.claude,target=${localEnv:HOME}/.claude,type=bind",
    // Mount current workspace
    "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached"
  ]
}

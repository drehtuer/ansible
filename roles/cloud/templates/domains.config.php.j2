<?php
{{ ansible_managed | comment }}
# An additional config file, same mechanism as cache.config.php:
# Nextcloud reads every config/*.config.php after config.php and only
# writes back to config.php itself.
#
# Nextcloud refuses any request whose Host is not in trusted_domains,
# so this list has to name every hostname the nginx configuration
# actually serves Nextcloud under. Two sources, both derived rather
# than listed by hand:
#
#   - cloud.<domain>, the vhost this role owns, for every domain.
#   - every static vhost that pulls in locations-enabled/*.conf, which
#     is what exposes the path-based /nextcloud location.
#
# NOTE: this key REPLACES trusted_domains from config.php rather than
# merging with it. A host that was reachable under some other name
# set by hand stops being reachable until that name is added to the
# inventory.
{% set hosts = [] %}
{% for d in http.domains %}
{%   set _ = hosts.append('cloud.' ~ d) %}
{%   for s in http.sites | selectattr('include_locations', 'defined')
                         | selectattr('include_locations') %}
{%     for sub in s.subdomains %}
{%       set _ = hosts.append(d if sub == '' else sub ~ '.' ~ d) %}
{%     endfor %}
{%   endfor %}
{% endfor %}
$CONFIG = [
    'trusted_domains' => [
{% for host in hosts | unique %}
        '{{ host }}',
{% endfor %}
    ],
    // Links generated by the background job and occ have no request
    // to derive a host from, so they need one named explicitly. The
    // primary domain's cloud vhost is the canonical entry point.
    'overwrite.cli.url' => 'https://cloud.{{ http.domains | first }}',
];

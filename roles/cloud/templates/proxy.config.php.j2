{{ ansible_managed | comment }}
# An additional config file, not config.php - the same mechanism as the
# cache, domains and logging drop-ins beside it.
#
# Required by Client Push. The notify_push daemon calls back into
# Nextcloud to verify a session, forwarding the real client's address in
# X-Forwarded-For; Nextcloud ignores that header unless the sender is a
# trusted proxy, so without this every pushed event is attributed to the
# push server itself. `occ notify_push:setup` refuses to complete and
# says so explicitly:
#
#   push server is not a trusted proxy by Nextcloud or another proxy in
#   the chain. Nextcloud resolved the following client address ...
#   instead of the expected "1.2.3.4" test value.
#
# Both loopback addresses and both of this host's public addresses: the
# daemon reaches Nextcloud through the public name, so the request
# arrives from a public address rather than from 127.0.0.1.
#
# Note this only widens which senders may *claim* a client address, and
# every address listed is this host itself. nginx talks to PHP over
# FastCGI rather than HTTP, so ordinary web requests never took this
# path in the first place.
$CONFIG = [
    'trusted_proxies' => [
        '127.0.0.1',
        '::1',
        '{{ ip_v4 }}',
        '{{ ip_v6 }}',
    ],
];

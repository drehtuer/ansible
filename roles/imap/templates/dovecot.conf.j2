!include_try /usr/share/dovecot/protocols.d/*.protocol
protocols = imap lmtp
listen = *, ::

# Auth
disable_plaintext_auth = yes
auth_mechanisms = plain login
auth_username_format = %n
passdb {
  driver = pam
}
userdb {
  driver = passwd
}

# Logging
log_path = /var/log/dovecot.log

# Mailbox
mail_location = maildir:~/.mail
namespace inbox {
  type = private
  inbox = yes
  hidden = no
  list = yes
  subscriptions = yes
}
mail_privileged_group = mail
mail_access_groups = mail

# Master
service imap-login {
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}

protocol lmtp {
  postmaster_address = postmaster@{{ domain }}
  mail_plugins = $mail_plugins sieve
}

# imap_sieve is what makes the imapsieve_mailbox* rules below do
# anything at all. Without it dovecot loads the settings, reports no
# error, and simply never fires the training scripts - moving a
# message into TrainSpam succeeds and teaches RSpamd nothing.
protocol imap {
  mail_plugins = $mail_plugins imap_sieve
}

service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
}

# SSL
ssl = yes
ssl_cert = <{{ imap.conf.ssl.cert }}
ssl_key = <{{ imap.conf.ssl.key }}
ssl_ca = <{{ imap.conf.ssl.ca }}
ssl_dh = <{{ imap.conf.ssl.dh }}
ssl_min_protocol = TLSv1.2
ssl_cipher_list = HIGH:!aNULL:!MD5:!3DES:!RC4:!DSS:!SHA1:!SHA256:!SHA384:!CAMELLIA128:!CAMELLIA256
ssl_prefer_server_ciphers = yes

# Mailbox definitions
namespace inbox {
  mailbox Drafts {
    special_use = \Drafts
  }
  mailbox Sent {
    special_use = \Sent
  }
  mailbox "Sent Messages" {
    special_use = \Sent
  }
  mailbox Archive {
    special_use = \Archive
  }
  mailbox Spam {
    special_use = \Junk
    # Created on first spam by the delivery sieve's `fileinto :create`,
    # but declared here so it exists and is subscribed from the start.
    auto = subscribe
  }
  # Training folder, deliberately separate from Spam. Moving a message
  # *into* it trains that message as spam; moving one *out* trains it
  # as ham. Keeping it apart from Spam means the automatic filing of
  # spam is not itself taken as a training signal.
  mailbox TrainSpam {
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
  }
}

# Sieve
plugin {
  # sieve_imapsieve as well as sieve_extprograms: the learn-ham and
  # learn-spam scripts open with `require ["imapsieve"]`, and that
  # capability only exists once this plugin is loaded. Without it
  # `sievec` refuses to compile them - "unknown Sieve capability
  # `imapsieve'" - and the role fails in its compile handler.
  # Runs before any per-user script, on every delivery, which is how
  # spam gets filed without each account needing its own sieve.
  sieve_before = /etc/dovecot/sieve/spam-to-folder.sieve
  sieve_plugins = sieve_imapsieve sieve_extprograms
  sieve_extensions = +vnd.dovecot.pipe
  sieve_pipe_bin_dir = /etc/dovecot/sieve-pipe
}

plugin {
  imapsieve_mailbox1_name = TrainSpam
  imapsieve_mailbox1_causes = COPY
  imapsieve_mailbox1_before = file:/etc/dovecot/sieve/learn-spam.sieve
  
  imapsieve_mailbox2_name = *
  imapsieve_mailbox2_from = TrainSpam
  imapsieve_mailbox2_causes = COPY
  imapsieve_mailbox2_before = file:/etc/dovecot/sieve/learn-ham.sieve
}

{{ ansible_managed | comment }}
# Upstream for the distribution's default PHP-FPM pool.
#
# Lives in conf.d because an `upstream` belongs at http level, and is
# named after the detected PHP version - the socket is
# php<version>-fpm.sock, never php-fpm.sock.
upstream php_default {
    server unix:/run/php/php{{ http_php_version }}-fpm.sock;
}

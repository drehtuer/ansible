{{ ansible_managed | comment }}
# https://www.ntp.org/documentation/
# https://community.hetzner.com/tutorials/install-and-configure-ntp

# Persist the clock drift across restarts.
driftfile /var/lib/ntpsec/ntp.drift
leapfile /usr/share/zoneinfo/leap-seconds.list

# Deny everything by default, but still accept the replies to
# queries we made ourselves.
#
# A blanket `ignore` would need a matching `restrict` line per
# upstream server, and those only ever pin the single address the
# name happened to resolve to at startup - which silently breaks
# for rotating pool names.
#
# `nopeer` is deliberately absent: ntpsec dropped it, logs "CONFIG:
# restrict nopeer ignored" once per line at every start, and no
# longer mobilises the ephemeral peer associations it used to guard
# against. Leaving it in changed nothing except adding two warnings
# to every restart.
restrict    default kod nomodify noquery limited
restrict -6 default kod nomodify noquery limited

# local connection is allowed
restrict    127.0.0.1
restrict -6 ::1

# NTP server
{% for server in time.ntp.server %}
server      {{ server }} iburst
{% endfor %}

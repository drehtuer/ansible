{{ ansible_managed | comment }}
server {
  listen {{ http.port_https }} ssl http2;
  listen [::]:{{ http.port_https }} ssl http2;

  include conf-server/ssl.conf;
  include conf-server/security.conf;
  include conf-server/general.conf;

  # One name per served domain, same as the cloud vhost. The
  # certificate already covers spam.<domain> for each of them through
  # http.letsencrypt.subdomains.
  server_name {{ http.domains | map('regex_replace', '^', 'spam.') | join(' ') }};

  location / {
    auth_basic "Restricted Access";
    auth_basic_user_file /etc/nginx/sites-enabled/spam.htpasswd;

    proxy_pass http://127.0.0.1:{{ spam.http_port }}/;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}

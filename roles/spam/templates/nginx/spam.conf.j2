server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;

  include conf-server/ssl.conf;
  include conf-server/security.conf;
  include conf-server/general.conf;

  server_name spam.{{ domain }};

  location / {
    auth_basic "Restricted Access";
    auth_basic_user_file /etc/nginx/sites-enabled/spam.htpasswd;

    proxy_pass http://127.0.0.1:{{ spam.http_port }}/;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  include locations-enabled/letsencrypt.conf;
}

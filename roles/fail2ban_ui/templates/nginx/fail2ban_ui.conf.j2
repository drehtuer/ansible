{{ ansible_managed | comment }}
#
# Reverse proxy for the fail2ban web UI, modelled on the `spam` vhost.
#
# The basic-auth block is the only authentication there is. The UI
# supports OIDC and nothing else, and this host runs no identity
# provider - so unlike the RSpamd controller behind spam.<domain>,
# which has a password of its own underneath, removing `auth_basic`
# here would leave the container's fail2ban socket reachable by anyone
# who can resolve the name.
server {
  listen {{ http.port_https }} ssl http2;
  listen [::]:{{ http.port_https }} ssl http2;

  include conf-server/ssl.conf;
  include conf-server/security.conf;
  include conf-server/general.conf;

  # One name per served domain, as the cloud and spam vhosts do. The
  # certificate covers each of them through http.letsencrypt.subdomains,
  # which must therefore list fail2ban_ui.subdomain.
  server_name {{ http.domains | map('regex_replace', '^', fail2ban_ui.subdomain ~ '.') | join(' ') }};

  location / {
    auth_basic "Restricted Access";
    auth_basic_user_file /etc/nginx/sites-enabled/fail2ban_ui.htpasswd;

    proxy_pass http://127.0.0.1:{{ fail2ban_ui.port }}/;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The UI uses a WebSocket for live ban events. Without these two
    # the page loads and then silently never updates, which looks like
    # a broken jail rather than a broken proxy.
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

compatibility_level = 3.6

myhostname = mail.{{ domain }}
mydomain = {{ domain }}
myorigin = $mydomain
inet_interfaces = all
inet_protocols = all

mynetworks = 127.0.0.0/8 [::1]/128

# SMTP defaults
smtpd_relay_restrictions = 
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_recipient_restrictions = 
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_sender_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_authenticated_sender_login_mismatch,
    reject_unknown_sender_domain

# SSL
smtpd_tls_cert_file = {{ mail.ssl.cert }}
smtpd_tls_key_file = {{ mail.ssl.key }}
smtpd_use_tls = yes
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes

smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtpd_tls_ciphers = high
smtpd_tls_mandatory_ciphers = high

# Outbound TLS. Opportunistic: try STARTTLS with every peer and fall
# back to cleartext for the ones that do not offer it, which is the
# only workable policy for a public MX - `encrypt` would bounce mail
# to any server still running without TLS.
#
# This setting is what actually turns outbound TLS on. Without it
# Postfix falls back to smtp_use_tls, which defaults to no, and the
# protocol/cipher lines below have no effect at all - so mail this
# host sent went out in the clear even to peers offering STARTTLS.
smtp_tls_security_level = may
smtp_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtp_tls_ciphers = high
smtp_tls_mandatory_ciphers = high

# One line per delivery recording whether it was encrypted and with
# what, so "was that message protected in transit" is answerable
# afterwards rather than a guess.
smtp_tls_loglevel = 1
smtpd_tls_loglevel = 1

smtpd_tls_received_header = yes
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth

smtpd_banner = $mydomain ESMTP

# LMTP -> dovecot
virtual_transport = lmtp:unix:private/dovecot-lmtp
# local_transport = error:local delivery disabled

mydestination = $myhostname, localhost.$mydomain, localhost
relay_domains = 
virtual_mailbox_domains = $mydomain $myhostname

# Mail aliases
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
virtual_alias_maps = hash:/etc/valiases

# RSpamd
smtpd_milters = inet:127.0.0.1:{{ spam.milter_port }}
non_smtpd_milters = inet:127.0.0.1:{{ spam.milter_port }}
milter_default_action = accept
milter_protocol = 6

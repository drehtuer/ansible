{{ ansible_managed | comment }}
#
# Terminates TLS for the signaling server and proxies the WebSocket to
# it on loopback. Talk's clients speak WebSocket, not plain HTTP, which
# is why this vhost carries the Upgrade/Connection dance and a long
# read timeout: a signaling connection is idle for as long as a call is
# quiet, and nginx's default 60s would tear it down mid-conversation.
server {
  listen {{ http.port_https }} ssl http2;
  listen [::]:{{ http.port_https }} ssl http2;

  include conf-server/ssl.conf;
  include conf-server/security.conf;
  include conf-server/general.conf;

  server_name {{ http.domains | map('regex_replace', '^', talk.subdomain ~ '.') | join(' ') }};

  location / {
    proxy_pass http://127.0.0.1:{{ talk.signaling_port }}/;
    proxy_http_version 1.1;
    # Without these two the upgrade never happens and every client
    # falls back to failing silently.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # A call can be silent for a long time; do not mistake that for a
    # dead connection.
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}

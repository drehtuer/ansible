{{ ansible_managed | comment }}
#
# Nextcloud Talk's high-performance backend: the signaling server,
# Janus as the WebRTC media gateway, NATS between them and eturnal as
# the TURN server, all in Nextcloud's own aio-talk image.
#
# WITHOUT THIS, Talk still works - browsers connect peer to peer - and
# it stops scaling at about four participants, because every client
# then sends its stream to every other client. The backend makes each
# client send once, to Janus, which forwards. That is the whole point
# of it, and why it needs real media ports rather than just an API.
#
# HOST NETWORKING, for the same reason as roles/fail2ban_ui but with
# the opposite consequence. There it kept the listener on loopback;
# here TURN has to be reachable from the public internet, and a
# published port would be DNATed - which for a TURN server means the
# addresses it advertises to clients are not the ones packets arrive
# on, and media silently fails to establish. Host networking gives it
# the host's own addresses, which is what it tells clients to use.
#
# The signaling server binds {{ talk.signaling_port }} on all interfaces as a
# consequence of that, and is *not* published deliberately: the
# firewall does not open it, so it is reachable only from this host,
# and nginx is what terminates TLS and proxies the WebSocket in.
services:
  talk:
    image: "{{ talk.image }}:{{ talk.tag }}@{{ talk.digest }}"
    container_name: nextcloud-talk
    restart: unless-stopped
    network_mode: host
    environment:
      # The Nextcloud this backend serves. The signaling server calls
      # back to it to authorise every session, so this must be the name
      # Nextcloud is actually reachable at, not an internal alias.
      NC_DOMAIN: "cloud.{{ domain }}"
      # TURN listens here on TCP *and* UDP. The one port that must be
      # open to the internet - see roles/firewall.
      TALK_PORT: "{{ talk.turn_port }}"
      TURN_SECRET: "{{ talk.secrets.turn }}"
      # Shared with Nextcloud, which presents it when it calls the
      # signaling server. Registered on the Nextcloud side by this
      # role's `occ talk:signaling:add`.
      SIGNALING_SECRET: "{{ talk.secrets.signaling }}"
      # Between the signaling server and its own components. Never
      # leaves this host.
      INTERNAL_SECRET: "{{ talk.secrets.internal }}"
      TURN_DOMAIN: "{{ talk.subdomain }}.{{ domain }}"
      TALK_MAX_STREAM_BITRATE: "{{ talk.max_stream_bitrate }}"
      TALK_MAX_SCREEN_BITRATE: "{{ talk.max_screen_bitrate }}"

{{ ansible_managed | comment }}
#
# A timer rather than cron, for the same reason as the nsd re-signing
# one: this host reboots for unattended upgrades, and cron silently
# skips a run whose moment passed while it was down.
#
# The files these write are read on every scrape whatever their age,
# so a collector that stops leaves the last values in place looking
# current. node_exporter's own mtime metric is what gives that away -
# node_textfile_mtime_seconds is scraped alongside them.
[Unit]
Description=Run the {{ collector }} textfile collector

[Timer]
OnBootSec=2min
OnUnitActiveSec={{ collector_interval }}
AccuracySec=10s

[Install]
WantedBy=timers.target

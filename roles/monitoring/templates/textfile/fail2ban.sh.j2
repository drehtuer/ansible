#!/usr/bin/env bash
{{ ansible_managed | comment }}
#
# Writes fail2ban's own counters into node_exporter's textfile
# directory. There is no fail2ban exporter in the archive, and the
# numbers are worth having: "Total failed" on the sshd jail is the
# count of failed SSH logins as the filter sees them, which is the one
# authentication failure this host cannot otherwise measure - sshd
# reports it to the journal and nowhere else.
#
# Counters here reset when fail2ban restarts, which is what `rate()`
# is for; a graph of the raw counter would show a cliff rather than a
# fault.
set -euo pipefail

OUT="{{ monitoring.node_exporter.textfile_dir }}/fail2ban.prom"
TMP="$(mktemp "${OUT}.XXXXXX")"
# node_exporter reads whatever is in the directory the moment it is
# scraped, so the file is written elsewhere and moved into place -
# a half-written file would otherwise be parsed as truncated.
trap 'rm -f "$TMP"' EXIT

emit() { printf '%s\n' "$*" >> "$TMP"; }

emit "# HELP fail2ban_up Whether fail2ban answered its control socket."
emit "# TYPE fail2ban_up gauge"

if ! jails="$(fail2ban-client status 2>/dev/null)"; then
  emit "fail2ban_up 0"
  chmod 0644 "$TMP"
  mv "$TMP" "$OUT"
  trap - EXIT
  exit 0
fi
emit "fail2ban_up 1"

emit "# HELP fail2ban_jail_failed_current Hosts currently over the failure threshold."
emit "# TYPE fail2ban_jail_failed_current gauge"
emit "# HELP fail2ban_jail_failed_total Failures matched since fail2ban started."
emit "# TYPE fail2ban_jail_failed_total counter"
emit "# HELP fail2ban_jail_banned_current Addresses banned right now."
emit "# TYPE fail2ban_jail_banned_current gauge"
emit "# HELP fail2ban_jail_banned_total Bans issued since fail2ban started."
emit "# TYPE fail2ban_jail_banned_total counter"

# `Jail list:` is comma-separated and tab-indented; the sed strips the
# label, the tr turns it into one name per line.
for jail in $(sed -n 's/.*Jail list:[[:space:]]*//p' <<<"$jails" | tr ',' ' '); do
  status="$(fail2ban-client status "$jail" 2>/dev/null)" || continue
  # Each line is "|  |- Currently failed:<TAB>0", so the value is what
  # follows the last tab.
  value() { sed -n "s/.*${1}:[[:space:]]*//p" <<<"$status" | tr -d '[:space:]'; }
  emit "fail2ban_jail_failed_current{jail=\"${jail}\"} $(value 'Currently failed')"
  emit "fail2ban_jail_failed_total{jail=\"${jail}\"} $(value 'Total failed')"
  emit "fail2ban_jail_banned_current{jail=\"${jail}\"} $(value 'Currently banned')"
  emit "fail2ban_jail_banned_total{jail=\"${jail}\"} $(value 'Total banned')"
done

chmod 0644 "$TMP"
mv "$TMP" "$OUT"
trap - EXIT

{{ ansible_managed | comment }}
#
# {{ monitoring.subdomain }}.<domain> - the monitoring frontend.
#
# Three applications on one vhost, behind one basic-auth credential:
# Grafana at /, Prometheus at {{ monitoring.prometheus.path }} and
# Alertmanager at {{ monitoring.alertmanager.path }}.
#
# This name previously served a static placeholder through http.sites.
# That entry is gone and the role deletes the vhost file it left
# behind, because the http role creates and enables sites from its list
# but never removes one dropped from it - two vhosts claiming the same
# server_name pass `nginx -t` and whichever loaded first wins.
#
# WHAT EXPOSING ALERTMANAGER MEANS. Its web interface is where alerts
# are silenced, so anyone holding the basic-auth credential can switch
# monitoring off without leaving a trace anywhere else. That was a
# deliberate decision rather than an oversight; the alternative is an
# SSH tunnel to 127.0.0.1:{{ monitoring.alertmanager.port }}.
#
# conf-server/security.conf is deliberately NOT included here. It sets
# the same headers at server level, and nginx *accumulates* add_header
# at one level rather than replacing - two Content-Security-Policy
# headers are intersected by the browser, which would undo the policy
# widened below. Its headers are reproduced here instead, and so is its
# dot-file deny, which is not idle: bots probe this name for /.env.
server {
  listen {{ http.port_https }} ssl http2;
  listen [::]:{{ http.port_https }} ssl http2;

  include conf-server/ssl.conf;
  include conf-server/general.conf;

  # One name per served domain, as the cloud, spam and fail2ban_ui
  # vhosts do. The certificate covers each through
  # http.letsencrypt.subdomains, which must list monitoring.subdomain.
  server_name {{ http.domains | map('regex_replace', '^', monitoring.subdomain ~ '.') | join(' ') }};

  # Declared once at server level so all three locations inherit them.
  # None of the locations below may declare an add_header of its own:
  # nginx drops every inherited one the moment a block sets any, which
  # is the rule roles/cloud has to work around, and it is invisible to
  # `nginx -t`.
  #
  # The policy is security.conf's, widened by 'unsafe-eval' and blob:.
  # Grafana needs the first for its expression and transformation
  # engine and the second for rendering; without them the page returns
  # 200, loads its JavaScript and draws nothing. A status code does not
  # test this - a browser does.
  add_header X-Content-Type-Options    "nosniff" always;
  add_header Referrer-Policy           "no-referrer-when-downgrade" always;
  add_header Content-Security-Policy   "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
  add_header Permissions-Policy        "interest-cohort=()" always;
  # Repeated verbatim from conf-server/security.conf. Every HSTS header
  # in this repo carries this exact value, without the `preload` token
  # - see doc/STATUS.adoc.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # From conf-server/security.conf, which this vhost cannot include.
  location ~ /\.(?!well-known) {
      deny all;
  }

  # Grafana.
  location / {
    auth_basic "Restricted Access";
    auth_basic_user_file /etc/nginx/sites-enabled/monitoring.htpasswd;

    proxy_pass http://{{ monitoring.grafana.listen_address }}:{{ monitoring.grafana.port }}/;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Cleared deliberately, and this one only breaks in a browser.
    # nginx does not consume the credential it just checked - it
    # forwards the Authorization header upstream, and Grafana reads a
    # `Basic` header as a login attempt against its *own* user
    # database. The outer credential is not a Grafana user, so Grafana
    # answers 401 with its own WWW-Authenticate, the browser re-prompts
    # with the same credential, and the page never loads. curl sees
    # none of this, because it stops at the first 401 it is given.
    proxy_set_header Authorization "";

    # Grafana Live holds a WebSocket open for its own updates. Without
    # these the dashboards still load and the connection is retried in
    # a loop, which reads as a broken page rather than a broken proxy.
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  # Prometheus: the query console, and the only place that shows scrape
  # target health and rule state, neither of which Grafana can render.
  #
  # The prefix is NOT stripped. Prometheus is started with
  # --web.external-url ending in this path, which becomes its route
  # prefix, so it already serves and self-links under it. Stripping
  # here would make it redirect / to /graph at the vhost root, landing
  # on Grafana.
  location {{ monitoring.prometheus.path }} {
    auth_basic "Restricted Access";
    auth_basic_user_file /etc/nginx/sites-enabled/monitoring.htpasswd;

    proxy_pass http://{{ monitoring.prometheus.listen_address }}:{{ monitoring.prometheus.port }};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Neither of these has authentication of its own, so the credential
    # would simply be ignored - cleared anyway, so that the one secret
    # guarding this vhost is not handed to three separate processes.
    proxy_set_header Authorization "";
  }

  # Alertmanager: current alerts, and silences. Same route-prefix
  # reasoning as Prometheus above.
  location {{ monitoring.alertmanager.path }} {
    auth_basic "Restricted Access";
    auth_basic_user_file /etc/nginx/sites-enabled/monitoring.htpasswd;

    proxy_pass http://{{ monitoring.alertmanager.listen_address }}:{{ monitoring.alertmanager.port }};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "";
  }
}

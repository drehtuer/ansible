{{ ansible_managed | comment }}
#
# status.<domain> - the monitoring frontend, modelled on the spam and
# fail2ban_ui vhosts.
#
# This name previously served a static placeholder through http.sites.
# That entry is gone and the role deletes the vhost file it left
# behind, because the http role creates and enables sites from its
# list but never removes one dropped from it - two vhosts claiming the
# same server_name pass `nginx -t` and whichever loaded first wins.
#
# WHAT IS AND IS NOT EXPOSED HERE. Grafana only. Prometheus and
# Alertmanager stay on loopback with no vhost: Grafana's backend
# proxies to Prometheus, so nothing needs them reachable, and exposing
# Alertmanager would put silencing - i.e. switching alerts off - behind
# nothing but this basic-auth credential.
server {
  listen {{ http.port_https }} ssl http2;
  listen [::]:{{ http.port_https }} ssl http2;

  include conf-server/ssl.conf;
  # Included for the dot-file deny it also carries. Its headers are
  # deliberately replaced below.
  include conf-server/security.conf;
  include conf-server/general.conf;

  # One name per served domain, as the cloud, spam and fail2ban_ui
  # vhosts do. The certificate covers each through
  # http.letsencrypt.subdomains, which must therefore list
  # monitoring.grafana.subdomain.
  server_name {{ http.domains | map('regex_replace', '^', monitoring.grafana.subdomain ~ '.') | join(' ') }};

  location / {
    auth_basic "Restricted Access";
    auth_basic_user_file /etc/nginx/sites-enabled/monitoring.htpasswd;

    # nginx drops every inherited add_header the moment a block
    # declares one of its own, so the whole set from
    # conf-server/security.conf is repeated here rather than extended -
    # the same inheritance rule roles/cloud has to work around, and
    # getting it wrong is invisible to `nginx -t`.
    #
    # The one deliberate difference is the policy itself. Grafana will
    # not run under the shared CSP: it needs 'unsafe-eval' for the
    # expression and transformation engine, and blob: workers for
    # rendering. Under the shared policy the page returns 200, loads
    # its JavaScript and then renders nothing - which is exactly why a
    # status code is not evidence that this works. Check it in a
    # browser after changing either policy.
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy   "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
    add_header Permissions-Policy        "interest-cohort=()" always;
    # Repeated verbatim from conf-server/security.conf. Every HSTS
    # header in this repo carries this exact value, without the
    # `preload` token - see doc/STATUS.adoc.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    proxy_pass http://{{ monitoring.grafana.listen_address }}:{{ monitoring.grafana.port }}/;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Cleared deliberately, and this one only breaks in a browser.
    # nginx does not consume the credential it just checked - it
    # forwards the Authorization header upstream, and Grafana reads a
    # `Basic` header as a login attempt against its *own* user
    # database. The outer credential is not a Grafana user, so Grafana
    # answers 401 with its own WWW-Authenticate, the browser re-prompts
    # with the same credential, and the page never loads. curl sees
    # none of this, because it stops at the first 401 it is given.
    proxy_set_header Authorization "";

    # Grafana Live holds a WebSocket open for its own updates. Without
    # these the dashboards still load and the connection is retried in
    # a loop, which reads as a broken page rather than a broken proxy.
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

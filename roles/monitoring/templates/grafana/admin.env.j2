{{ ansible_managed | comment }}
# The Grafana admin credential, kept out of compose.yml so that a
# --diff from `invoke check-drift` cannot print it. Written 0600 by a
# task carrying no_log.
#
# Grafana reads these at *first* start to create the admin account,
# and on later starts only to reset the password if it differs. So
# changing the value here does take effect on the next run, but the
# account itself is created once and lives in Grafana's database.
GF_SECURITY_ADMIN_USER={{ monitoring.grafana.admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ monitoring.grafana.admin_password }}

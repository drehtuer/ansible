# https://yamllint.readthedocs.io/en/stable/configuration.html
#
# Shared YAML style for this repo. ansible-lint picks this file up
# automatically and uses it instead of its own built-in yamllint
# defaults, so `invoke lint-yaml` and `invoke lint-ansible` agree on
# what valid YAML looks like here.

extends: default

# Skips log/, vault/ and roles/sshd/keys/ without repeating them here.
ignore-from-file: .gitignore

rules:
  # The three settings ansible-lint insists on. It reads this file
  # instead of its own defaults, so a disagreement makes it warn on
  # every run and disable its `--fix` transforms entirely.
  #
  # All three are *relaxations* of the yamllint defaults (2 spaces
  # before an inline comment, comment indentation checked, no spaces
  # inside braces), so nothing that passes today starts failing.
  #
  # NOTE: making `ansible-lint --fix` available is not the same as
  # making it safe to run here. Its transforms rewrite YAML in its own
  # house style - `---` document starts on every file, reflowed
  # comments and description blocks, different quoting - which
  # contradicts the deliberate choices below and would touch ~130
  # files. Use `invoke lint` to check; do not use `invoke lint --fix`
  # on the YAML unless that whole-repo reformat is actually wanted.
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1

  # This repo does not prefix its YAML files with `---`.
  document-start: disable

  # 2 spaces everywhere, list items indented below their key:
  #   packages:
  #     - bash
  indentation:
    spaces: 2
    indent-sequences: true

  # 80 columns, matching `.editorconfig` and ruff. The YAML in this
  # repo already fits, so this is a floor to hold rather than a
  # reformatting exercise. Long Jinja expressions are folded with
  # `>-` instead of being allowed to run on.
  line-length:
    max: 80

  # Ansible expects true/false, not yes/no/on/off. Keys are exempt so
  # that the GitHub Actions `on:` trigger is not flagged as a boolean.
  truthy:
    allowed-values:
      - 'true'
      - 'false'
    check-keys: false

  # File modes must be quoted strings (`mode: "0644"`); a bare 0644 is
  # read as decimal 644 by YAML and silently applies the wrong mode.
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
